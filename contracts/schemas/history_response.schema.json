{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glucotwin.local/contracts/v1/history_response.schema.json",
  "title": "HistoryResponse",
  "description": "Observed records only. Each array is sorted by ascending `timestamp`.\n`heart_rate` is `[]` (not null) when the modality is absent for this participant.\n",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "participant_id",
    "cgm",
    "meals",
    "heart_rate"
  ],
  "properties": {
    "participant_id": {
      "type": "string"
    },
    "cgm": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CgmPoint"
      }
    },
    "meals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MealRecord"
      }
    },
    "heart_rate": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HeartRatePoint"
      }
    }
  },
  "$defs": {
    "CgmPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "glucose_mg_dl"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "RFC3339, offset-aware, normalized to UTC."
        },
        "glucose_mg_dl": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "description": "Interstitial glucose in mg/dL. Non-finite and negative values are rejected at ingestion."
        }
      }
    },
    "HeartRatePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "heart_rate_bpm"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "heart_rate_bpm": {
          "type": "number",
          "format": "double",
          "minimum": 0
        },
        "resting_heart_rate_bpm": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0,
          "description": "Optional. `null` when the source does not supply it."
        }
      }
    },
    "MealRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meal_id",
        "participant_id",
        "timestamp"
      ],
      "description": "An observed meal. Macronutrients are optional at ingestion; a meal with missing\nmacros cannot be used as a prediction input without a reviewed estimate.\n",
      "properties": {
        "meal_id": {
          "type": "string",
          "minLength": 1
        },
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "carbs_g": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0
        },
        "protein_g": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0
        },
        "fat_g": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0
        },
        "fiber_g": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0
        },
        "calories_kcal": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0
        },
        "image_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque reference to a meal photo held by the data layer. Never a filesystem\npath resolved from client input. Nutrition is NOT inferred from images unless a\nreviewed, licensed service is in use.\n"
        }
      }
    }
  }
}
