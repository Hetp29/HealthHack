# GLIMPSE environment template -- copy to `.env` and adjust.
# `.env` is gitignored. NEVER commit real credentials or temporary AWS tokens.

# ---- Backend ----
# Contract version served by this process. Do not change without a contract bump.
GLUCOTWIN_CONTRACT_VERSION=1.0.0

# Trained model artifact. The API returns 503 model_not_trained when absent.
GLUCOTWIN_MODEL_ARTIFACT=ml/artifacts/model.joblib

# Evaluation report surfaced by GET /api/model/metrics.
# When absent, the endpoint returns an explicitly empty report.
GLUCOTWIN_METRICS_PATH=ml/artifacts/metrics.json

# Data layer. `synthetic_dev` uses the labelled temporary ML dev fixture.
# `sqlite` binds Het's canonical repository once available.
GLUCOTWIN_DATA_BACKEND=synthetic_dev
GLUCOTWIN_DB_URL=sqlite:///data/glucotwin.db

# CORS allowlist for the frontend. Comma-separated exact origins; no wildcard in prod.
GLUCOTWIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: DEBUG | INFO | WARNING | ERROR
GLUCOTWIN_LOG_LEVEL=INFO

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000

# =========================== v2 application layer =========================== #
# Start command:  uvicorn backend.app.v2.asgi:app --host 0.0.0.0 --port 8000
# Migrate first:  alembic upgrade head

# Application database (users, meals, CGM, predictions). Separate from GLUCOTWIN_DB_URL,
# which is the research warehouse. PostgreSQL in the cloud:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/glucotwin
GLUCOTWIN_APP_DB_URL=sqlite:///data/local/glucotwin_app.db

# Production MUST set this to the frozen fs-1.3 checksum. When set, v2 refuses to
# forecast with any other artifact and /api/v2/ready reports not ready.
# GLUCOTWIN_EXPECTED_MODEL_SHA256=12ed06026f34eae252fda5a837ff404cb91a4d0d56253fe8d1fc6b43597415fe

# Leave at history_only. The other value (history_plus_frozen_calibration) is ruled
# NOT APPROVED FOR ENABLEMENT -- DECISIONS D-007. Never set it in a deployed environment.
GLUCOTWIN_PERSONALIZATION_POLICY=history_only
GLUCOTWIN_OUTCOME_GRACE_MINUTES=30
GLUCOTWIN_REGISTRATION_OPEN=true
GLUCOTWIN_SESSION_TTL_HOURS=336

# Meal photos: local directory, or a private S3 bucket when the bucket name is set.
GLUCOTWIN_IMAGE_DIR=data/local/meal_images
# GLUCOTWIN_IMAGE_S3_BUCKET=
# GLUCOTWIN_IMAGE_S3_PREFIX=meal-images/
GLUCOTWIN_MAX_IMAGE_BYTES=10485760

# OpenAI meal analysis. Server-side only -- never put this key in a VITE_ variable.
# Both must be set, or analysis returns 503 vision_not_configured. There is no default model.
# OPENAI_API_KEY=
# GLUCOTWIN_OPENAI_VISION_MODEL=
GLUCOTWIN_OPENAI_TIMEOUT_SECONDS=45
GLUCOTWIN_VISION_DAILY_LIMIT=40

# Device providers. Unset = the provider reports "not configured".
# Generate the key with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GLUCOTWIN_TOKEN_ENCRYPTION_KEY=
# GLUCOTWIN_PUBLIC_API_BASE_URL=https://api.example.com
# GLUCOTWIN_FRONTEND_RETURN_URL=https://app.example.com/devices
# DEXCOM_CLIENT_ID=
# DEXCOM_CLIENT_SECRET=
# DEXCOM_ENVIRONMENT=sandbox
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=

# ============================ demonstration replay =========================== #
# OFF by default, and it must stay off anywhere real users exist: with it off the
# /api/v2/demo routes are not registered at all.
# GLUCOTWIN_DEMO_MODE=1
# Password for the fictional demo account. Required to seed or reset. No default.
# GLUCOTWIN_DEMO_PASSWORD=
# GLUCOTWIN_DEMO_EMAIL=demo@glimpse.example
# The research-data bundle to replay. Not in git; build it with `python -m scripts.demo_select`
# or copy it from the artifact store. Its checksum must match backend/app/v2/demo/manifest.json.
# GLUCOTWIN_DEMO_BUNDLE=data/local/demo/cgmacros_demo_bundle.json
# Optional second demonstration (RETURNING USER): its own account and bundle.
# Build the bundle with `python -m scripts.demo_select --scenario returning_user`.
# GLUCOTWIN_DEMO_RETURNING_EMAIL=demo-returning@glimpse.example
# GLUCOTWIN_DEMO_RETURNING_BUNDLE=data/local/demo/cgmacros_returning_user_bundle.json
